{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GRZ-Nachweis",
  "version": "0.2.0",
  "identifier": "de.pendzialek.grz-nachweis",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GRZ-Nachweis",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "decorations": false,
        "shadow": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "category": "Productivity",
    "shortDescription": "GRZ/GFZ-Nachweis nach BauNVO und BauO NRW",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "German"
        ]
      },
      "wix": {
        "language": "de-DE"
      }
    }
  }
}
